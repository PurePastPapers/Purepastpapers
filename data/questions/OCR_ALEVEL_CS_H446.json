    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Explain two differences between packet switching and circuit switching.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Packet switching splits data into packets that may take different routes</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">whereas circuit switching sets up a dedicated path for the whole communication</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Packet switching shares links between many users, making efficient use of the network</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">whereas a circuit is reserved even when no data is being sent</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
