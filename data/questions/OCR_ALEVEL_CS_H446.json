    "content": {
      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Convert the denary number −37 into 8-bit two's complement binary. Show your working.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Convert the hexadecimal number 3F into denary.</div><span class=\"q-marks\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">State the range of values that can be stored in 8-bit two's complement.</div><span class=\"q-marks\">(1)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">37 = 00100101; invert and add 1</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">11011011</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">63</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">−128 to 127</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
