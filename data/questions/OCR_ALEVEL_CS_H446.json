    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Describe the role of each of these registers during the fetch–decode–execute cycle: the program counter, the memory address register and the accumulator.</div><span class=\"q-marks\">(3)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Program counter: holds the address of the next instruction to be fetched</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Memory address register: holds the address in memory that is about to be read from or written to</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Accumulator: holds the results of calculations carried out by the ALU</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
