    "content": {
      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Simplify the Boolean expression (A ∧ B) ∨ (A ∧ ¬B) ∨ (¬A ∧ B). Show each step.</div><span class=\"q-marks\">(3)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Complete a truth table to confirm that your simplified expression is equivalent.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">(A ∧ B) ∨ (A ∧ ¬B) = A ∧ (B ∨ ¬B) = A</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">A ∨ (¬A ∧ B) = (A ∨ ¬A) ∧ (A ∨ B)</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">= A ∨ B</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Correct outputs for the original expression: 0, 1, 1, 1 for AB = 00, 01, 10, 11</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Matching outputs for A ∨ B</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
