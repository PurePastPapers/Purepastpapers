    "content": {
      "question_html": "<p>An atom of sodium has an atomic number of 11 and a mass number of 23.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">State the number of protons, neutrons and electrons in this atom.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Write the electronic configuration of sodium.</div><span class=\"q-marks\">(1)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">11 protons and 11 electrons</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">12 neutrons</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">2.8.1</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
