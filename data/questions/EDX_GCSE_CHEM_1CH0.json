    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Use collision theory to explain why increasing the temperature increases the rate of a reaction.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Particles gain kinetic energy and move faster</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">so collisions are more frequent</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">More particles have energy equal to or greater than the activation energy</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">so a greater proportion of collisions are successful</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
