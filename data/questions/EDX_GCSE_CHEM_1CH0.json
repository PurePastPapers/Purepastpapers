    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Describe how crude oil is separated into fractions by fractional distillation.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">The crude oil is heated until most of it evaporates</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">The vapour enters a fractionating column that is hotter at the bottom and cooler at the top</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Vapours rise and condense at the level where the temperature is below their boiling point</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Fractions with larger molecules and higher boiling points are collected lower down</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
