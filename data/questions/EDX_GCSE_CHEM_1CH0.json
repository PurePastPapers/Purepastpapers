    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Explain why sodium chloride has a high melting point and conducts electricity when molten but not when solid.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">It has a giant ionic lattice with strong electrostatic forces between oppositely charged ions</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">A large amount of energy is needed to overcome these forces</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">When solid the ions are fixed in position and cannot move</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">When molten the ions are free to move and carry charge</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
