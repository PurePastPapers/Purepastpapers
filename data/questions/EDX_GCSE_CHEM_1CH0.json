      "question_html": "<p>Molten lead bromide is electrolysed.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Name the product formed at each electrode.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Explain why the lead bromide must be molten.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Lead at the negative electrode (cathode)</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Bromine at the positive electrode (anode)</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">The ions must be free to move</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">so that they can carry charge to the electrodes; in a solid they are fixed in place</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
