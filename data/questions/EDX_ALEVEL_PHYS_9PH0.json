    "content": {
      "question_html": "<p>A car travelling at 12 m s<sup>−1</sup> accelerates uniformly at 1.5 m s<sup>−2</sup> for 8.0 s.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Calculate the final velocity of the car.</div><span class=\"q-marks\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Calculate the distance travelled during the acceleration.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">v = 12 + 1.5 × 8.0 = 24 m s<sup>−1</sup></div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Use of s = ut + <span class=\"frac\"><span class=\"frac__n\">1</span><span class=\"frac__d\">2</span></span>at<sup>2</sup></div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">s = 96 + 48 = 144 m</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
