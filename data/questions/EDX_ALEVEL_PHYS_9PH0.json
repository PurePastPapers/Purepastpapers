    "content": {
      "question_html": "<p>A student measures the diameter of a wire as 0.52 ± 0.01 mm.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Calculate the percentage uncertainty in the diameter.</div><span class=\"q-marks\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Calculate the percentage uncertainty in the cross-sectional area of the wire.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\"><span class=\"frac\"><span class=\"frac__n\">0.01</span><span class=\"frac__d\">0.52</span></span> × 100 = 1.9%</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Area depends on diameter squared, so the percentage uncertainty doubles</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">3.8%</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
