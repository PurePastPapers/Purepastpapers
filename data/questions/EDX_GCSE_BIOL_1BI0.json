      "question_html": "<p>A student puts a potato cylinder of mass 2.50 g into pure water. After 30 minutes its mass is 2.80 g.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Calculate the percentage change in mass.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Explain why the mass of the cylinder increased.</div><span class=\"q-marks\">(3)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\"><span class=\"frac\"><span class=\"frac__n\">2.80 − 2.50</span><span class=\"frac__d\">2.50</span></span> × 100</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">+12%</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Water moved into the potato cells by osmosis</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">from a dilute solution to a more concentrated solution</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">through a partially permeable membrane</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
