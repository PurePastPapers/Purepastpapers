    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Describe how ATP and reduced NADP are produced in the light-dependent reactions of photosynthesis.</div><span class=\"q-marks\">(5)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Light energy excites electrons in chlorophyll</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Electrons pass along the electron transport chain in the thylakoid membrane, releasing energy</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">The energy is used to produce ATP from ADP and inorganic phosphate (photophosphorylation)</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Photolysis of water produces electrons, hydrogen ions and oxygen</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Electrons and hydrogen ions reduce NADP</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
