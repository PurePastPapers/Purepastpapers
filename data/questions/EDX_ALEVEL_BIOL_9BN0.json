    "content": {
      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Describe the process of transcription.</div><span class=\"q-marks\">(3)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Explain how a mutation that changes one base in a gene could affect the protein produced.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">The DNA double helix unwinds and hydrogen bonds between the strands break</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Free RNA nucleotides pair with complementary bases on the template (antisense) strand</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">RNA polymerase joins the nucleotides to form mRNA</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">The altered triplet may code for a different amino acid, changing the primary structure</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">This may change the folding and tertiary structure, so the protein may not function</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
