    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Describe how the structure of an artery is related to its function.</div><span class=\"q-marks\">(3)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Thick wall to withstand high blood pressure</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Elastic fibres stretch and recoil to maintain pressure and smooth the flow of blood</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Narrow lumen maintains high pressure, or smooth endothelium reduces friction</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
