    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Explain how an action potential is generated and propagated along the axon of a neurone.</div><span class=\"q-marks\">(6)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">A stimulus causes voltage-gated sodium ion channels to open</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Sodium ions diffuse in, depolarising the membrane to about +40 mV</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Sodium channels close and voltage-gated potassium ion channels open</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Potassium ions diffuse out, repolarising the membrane</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Local currents depolarise the next section of membrane</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">The refractory period ensures the impulse travels in one direction only</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  }
