    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Describe the roles of T helper cells and B cells in the specific immune response to a bacterial infection.</div><span class=\"q-marks\">(6)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Antigen-presenting cells (such as macrophages) display bacterial antigens</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">T helper cells with complementary receptors bind to the antigen and are activated</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Activated T helper cells divide and release cytokines</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Cytokines stimulate B cells that have bound the same antigen to divide by mitosis</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">B cells differentiate into plasma cells that secrete antibodies specific to the antigen</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Memory cells remain and give a faster, larger secondary response</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
