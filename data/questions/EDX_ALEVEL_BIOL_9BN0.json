    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Explain the effect of increasing substrate concentration on the initial rate of an enzyme-catalysed reaction.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">At low concentrations the rate increases as substrate concentration increases</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">More frequent collisions, so more enzyme–substrate complexes form</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">At high concentrations the rate levels off</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">All active sites are occupied, so enzyme concentration is the limiting factor</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
