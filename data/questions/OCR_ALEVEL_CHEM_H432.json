    "content": {
      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Explain the trend in reactivity of the Group 2 metals down the group.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Write an equation for the reaction of chlorine with cold, dilute aqueous sodium hydroxide and state the type of reaction.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Atomic radius and shielding increase down the group</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Ionisation energies decrease, so electrons are lost more easily and reactivity increases</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Cl<sub>2</sub> + 2NaOH → NaCl + NaClO + H<sub>2</sub>O</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Disproportionation</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
