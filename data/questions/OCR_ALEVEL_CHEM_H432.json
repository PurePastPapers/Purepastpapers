    "content": {
      "question_html": "<p>A student reacts 2.50 g of calcium carbonate, CaCO<sub>3</sub>, with an excess of hydrochloric acid.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Calculate the amount, in mol, of CaCO<sub>3</sub> used.</div><span class=\"q-marks\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Calculate the volume of carbon dioxide formed at room temperature and pressure. (1 mol of gas occupies 24.0 dm<sup>3</sup> at RTP.)</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\"><span class=\"frac\"><span class=\"frac__n\">2.50</span><span class=\"frac__d\">100.1</span></span> = 0.0250 mol</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">1 mol of CaCO<sub>3</sub> forms 1 mol of CO<sub>2</sub></div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">0.0250 × 24.0 = 0.600 dm<sup>3</sup></div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
