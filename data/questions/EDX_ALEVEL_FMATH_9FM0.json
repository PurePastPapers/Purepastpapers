    "difficulty": "extra_hard",
    "primary_spec_points": ["EDX_FMATH_CP_ALG_4.4"],
    "crossover_spec_points": ["EDX_FMATH_CP_PROOF_1.1"],
    "content": {
      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Show that r × r! = (r + 1)! − r!.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Hence show that the sum of r × r! from r = 1 to n is (n + 1)! − 1.</div><span class=\"q-marks\">(3)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">Find, with justification, the remainder when the sum of r × r! from r = 1 to 100 is divided by 101.</div><span class=\"q-marks\">(3)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">(r + 1)! − r! = r!(r + 1 − 1) = r × r!</div><span class=\"ms-codes\">M1 A1</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Writes the sum as a telescoping series</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">All terms cancel except (n + 1)! and −1!</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Sum = (n + 1)! − 1</div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">The sum is 101! − 1</div><span class=\"ms-codes\">B1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">101! is a multiple of 101</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">So the remainder is 100</div><span class=\"ms-codes\">A1</span></div>",
      "mark_scheme_image_url": null
    }
  },
