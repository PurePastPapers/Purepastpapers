    "content": {
      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Find the general solution of the differential equation <span class=\"frac\"><span class=\"frac__n\">d<sup>2</sup> y</span><span class=\"frac__d\">dx<sup>2</sup></span></span> − 5<span class=\"frac\"><span class=\"frac__n\">dy</span><span class=\"frac__d\">dx</span></span> + 6y = 12x − 4.</div><span class=\"q-marks\">(6)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Find the particular solution for which y = 3 and <span class=\"frac\"><span class=\"frac__n\">dy</span><span class=\"frac__d\">dx</span></span> = 5 when x = 0.</div><span class=\"q-marks\">(3)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Auxiliary equation m<sup>2</sup> − 5m + 6 = 0, so m = 2 or 3</div><span class=\"ms-codes\">M1 A1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Complementary function Ae<sup>2x</sup> + Be<sup>3x</sup></div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Tries y = ax + b: −5a + 6(ax + b) = 12x − 4</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">a = 2, b = 1</div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">y = Ae<sup>2x</sup> + Be<sup>3x</sup> + 2x + 1</div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">A + B + 1 = 3 and 2A + 3B + 2 = 5</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">A = 3, B = −1</div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">y = 3e<sup>2x</sup> − e<sup>3x</sup> + 2x + 1</div><span class=\"ms-codes\">A1</span></div>",
      "mark_scheme_image_url": null
    }
  },
