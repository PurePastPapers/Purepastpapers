    "crossover_spec_points": ["EDX_MATH_PURE_TRIG_5.7"],
    "content": {
      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Use de Moivre's theorem to show that cos 3θ = 4cos<sup>3</sup> θ − 3cos θ.</div><span class=\"q-marks\">(4)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Hence find the three roots of the equation 8x<sup>3</sup> − 6x − 1 = 0, giving each answer in the form cos(kπ).</div><span class=\"q-marks\">(5)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">(cos θ + i sin θ)<sup>3</sup> = cos 3θ + i sin 3θ</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Expands and takes the real part: cos<sup>3</sup> θ − 3cos θ sin<sup>2</sup> θ</div><span class=\"ms-codes\">M1 A1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Uses sin<sup>2</sup> θ = 1 − cos<sup>2</sup> θ to obtain 4cos<sup>3</sup> θ − 3cos θ</div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Lets x = cos θ: 2(4cos<sup>3</sup> θ − 3cos θ) = 1</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">cos 3θ = <span class=\"frac\"><span class=\"frac__n\">1</span><span class=\"frac__d\">2</span></span></div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">3θ = <span class=\"frac\"><span class=\"frac__n\">π</span><span class=\"frac__d\">3</span></span>, <span class=\"frac\"><span class=\"frac__n\">5π</span><span class=\"frac__d\">3</span></span>, <span class=\"frac\"><span class=\"frac__n\">7π</span><span class=\"frac__d\">3</span></span></div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">x = cos <span class=\"frac\"><span class=\"frac__n\">π</span><span class=\"frac__d\">9</span></span>, cos <span class=\"frac\"><span class=\"frac__n\">5π</span><span class=\"frac__d\">9</span></span>, cos <span class=\"frac\"><span class=\"frac__n\">7π</span><span class=\"frac__d\">9</span></span></div><span class=\"ms-codes\">A1 A1</span></div>",
      "mark_scheme_image_url": null
    }
