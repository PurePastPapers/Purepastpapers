    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Compare aerobic and anaerobic respiration in human muscle cells.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Aerobic respiration uses oxygen; anaerobic respiration does not</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Aerobic respiration produces carbon dioxide and water</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Anaerobic respiration produces lactic acid</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Aerobic respiration transfers much more energy, because glucose is fully oxidised</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
