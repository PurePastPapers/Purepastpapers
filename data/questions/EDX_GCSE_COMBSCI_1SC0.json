    "content": {
      "question_html": "<p>A 4 Ω resistor and a 6 Ω resistor are connected in series with a 12 V battery.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Calculate the total resistance.</div><span class=\"q-marks\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Calculate the current in the circuit.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">Calculate the potential difference across the 6 Ω resistor.</div><span class=\"q-marks\">(1)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">10 Ω</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">I = V ÷ R = 12 ÷ 10</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">1.2 A</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">V = 1.2 × 6 = 7.2 V</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
