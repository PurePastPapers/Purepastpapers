    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Explain why the Group 1 metals become more reactive down the group.</div><span class=\"q-marks\">(3)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">The atoms get larger, so the outer electron is further from the nucleus</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">The attraction between the nucleus and the outer electron is weaker (more shielding)</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">so the outer electron is lost more easily</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
