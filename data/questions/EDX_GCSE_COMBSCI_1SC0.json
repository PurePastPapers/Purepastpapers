    "content": {
      "question_html": "<p>A student of mass 60 kg runs up a flight of stairs of vertical height 4.0 m in 5.0 s. Gravitational field strength = 10 N/kg.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Calculate the gain in gravitational potential energy of the student.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Calculate the useful power developed by the student.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">Explain why the total energy transferred by the student's muscles is greater than your answer to (a).</div><span class=\"q-marks\">(1)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">ΔGPE = m × g × Δh = 60 × 10 × 4.0</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">2400 J</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">P = <span class=\"frac\"><span class=\"frac__n\">2400</span><span class=\"frac__d\">5.0</span></span></div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">480 W</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">Some energy is dissipated to the surroundings, heating the body and the air</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  }
