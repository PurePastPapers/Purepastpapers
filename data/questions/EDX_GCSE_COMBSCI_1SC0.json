    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Describe how to make pure, dry crystals of copper sulfate from copper oxide and dilute sulfuric acid.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Add copper oxide to warm sulfuric acid until it is in excess (no more dissolves)</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Filter to remove the excess copper oxide</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Heat the solution gently to evaporate some of the water, then leave it to crystallise</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Pat the crystals dry with filter paper</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
