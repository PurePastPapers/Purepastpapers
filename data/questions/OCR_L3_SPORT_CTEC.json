    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Explain which energy system is predominant in a 100 m sprint and which is predominant in a 1500 m race.</div><span class=\"q-marks\">(6)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">100 m sprint: the ATP-PC system</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Maximal intensity for about 10 seconds</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Phosphocreatine is broken down to resynthesise ATP rapidly without oxygen</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">1500 m race: mainly the aerobic system, with a large contribution from the lactic acid system</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">The duration of several minutes exceeds the capacity of the anaerobic systems</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Glucose is broken down with oxygen to give a high yield of ATP</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
