    "content": {
      "question_html": "<p>A car of mass 1000 kg accelerates uniformly from 10 m/s to 25 m/s in 6.0 s.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Calculate the acceleration of the car.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Calculate the resultant force on the car.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">Calculate the distance travelled during the acceleration. Use v<sup>2</sup> − u<sup>2</sup> = 2as.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">a = <span class=\"frac\"><span class=\"frac__n\">25 − 10</span><span class=\"frac__d\">6.0</span></span></div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">2.5 m/s<sup>2</sup></div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">F = m × a = 1000 × 2.5</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">2500 N</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">s = <span class=\"frac\"><span class=\"frac__n\">25<sup>2</sup> − 10<sup>2</sup></span><span class=\"frac__d\">2 × 2.5</span></span></div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">105 m</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
