    "content": {
      "question_html": "<p>A kettle is connected to the 230 V mains supply. The current in the kettle is 10 A.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Calculate the power of the kettle.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Calculate the energy transferred by the kettle in 3 minutes.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">P = V × I = 230 × 10</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">2300 W</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">E = P × t = 2300 × 180</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">414 000 J</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
