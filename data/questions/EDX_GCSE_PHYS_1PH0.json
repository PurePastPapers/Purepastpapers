      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">A sound wave has a frequency of 250 Hz and a wavelength of 1.36 m. Calculate the speed of the wave.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">State whether sound waves are transverse or longitudinal.</div><span class=\"q-marks\">(1)</span></div>",
      "question_image_url": null,
