    "content": {
      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">The count rate from a radioactive source falls from 800 counts per minute to 100 counts per minute in 15 hours. Calculate the half-life of the source.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Describe what happens in the nucleus of an atom when it emits a beta particle.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">800 → 400 → 200 → 100 is three half-lives</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Half-life = 5 hours</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">A neutron changes into a proton</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">and a fast-moving electron is emitted from the nucleus</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
