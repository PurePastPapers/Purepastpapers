    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Describe a method to determine the density of a small, irregularly shaped stone.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Measure the mass of the stone using a balance</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Lower the stone into a displacement can, or a measuring cylinder partly filled with water</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Measure the volume of water displaced, which equals the volume of the stone</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Density = mass ÷ volume</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
