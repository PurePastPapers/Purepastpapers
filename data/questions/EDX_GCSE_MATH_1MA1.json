      "question_html": "<p>Here are the first four terms of a sequence: 4, 11, 18, 25.</p>\n<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Find an expression for the nth term.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Is 200 a term in this sequence? Show how you decide.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">7n</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">7n − 3</div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">7n − 3 = 200 gives n = 29</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Yes, because n is a whole number (it is the 29th term)</div><span class=\"ms-codes\">A1</span></div>",
      "mark_scheme_image_url": null
    }
