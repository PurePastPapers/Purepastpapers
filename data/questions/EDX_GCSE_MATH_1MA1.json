      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">A runner covers a distance of 120 m, correct to the nearest 10 m, in a time of 8.2 seconds, correct to 1 decimal place. Work out the upper bound for the runner's average speed. Give your answer to 3 significant figures.</div><span class=\"q-marks\">(5)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Upper bound of distance = 125 m</div><span class=\"ms-codes\">B1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Lower bound of time = 8.15 s</div><span class=\"ms-codes\">B1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Uses upper bound of distance ÷ lower bound of time</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">125 ÷ 8.15</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">15.3 m/s</div><span class=\"ms-codes\">A1</span></div>",
      "mark_scheme_image_url": null
    }
