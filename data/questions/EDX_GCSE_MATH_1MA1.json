      "question_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">Write x<sup>2</sup> − 6x + 11 in the form (x − a)<sup>2</sup> + b.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">Write down the coordinates of the turning point of the graph of y = x<sup>2</sup> − 6x + 11.</div><span class=\"q-marks\">(2)</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">Explain why the equation x<sup>2</sup> − 6x + 11 = 0 has no real solutions.</div><span class=\"q-marks\">(2)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">(x − 3)<sup>2</sup></div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">(x − 3)<sup>2</sup> + 2</div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">(3, 2)</div><span class=\"ms-codes\">B1 B1</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(c)</span><div class=\"q-part__body\">(x − 3)<sup>2</sup> is never negative, so the smallest value of the expression is 2</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">The expression is never 0, so the graph does not cross the x-axis</div><span class=\"ms-codes\">A1</span></div>",
      "mark_scheme_image_url": null
    }
