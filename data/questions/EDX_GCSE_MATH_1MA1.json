      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-part\"><span class=\"q-part__label\">(a)</span><div class=\"q-part__body\">8<sup>2</sup> + 15<sup>2</sup> = 289</div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">AC = 17 cm</div><span class=\"ms-codes\">A1</span></div>\n<div class=\"q-part\"><span class=\"q-part__label\">(b)</span><div class=\"q-part__body\">tan A = <span class=\"frac\"><span class=\"frac__n\">15</span><span class=\"frac__d\">8</span></span></div><span class=\"ms-codes\">M1</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">61.9°</div><span class=\"ms-codes\">A1</span></div>",
      "mark_scheme_image_url": null
    }
