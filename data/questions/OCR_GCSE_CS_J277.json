    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Explain two differences between a star network topology and a mesh network topology.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">In a star every device connects to a central switch; in a mesh devices connect directly to each other</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">so if the switch fails the whole star network fails, but a mesh can re-route data</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">A star needs less cabling</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">so it is cheaper and simpler to set up than a full mesh</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
