      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Describe the purpose of the arithmetic logic unit (ALU), the control unit, the cache and the registers in a CPU.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">ALU: carries out arithmetic calculations and logical comparisons</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Control unit: decodes instructions and sends signals to coordinate the other components</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Cache: very fast memory that stores frequently used instructions and data</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Registers: small, fast storage locations in the CPU that hold data being processed</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
