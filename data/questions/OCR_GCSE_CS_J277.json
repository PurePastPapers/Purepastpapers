      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">A bubble sort is used to put the list [5, 2, 9, 1] into ascending order. Show the list after each comparison in the first pass.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Compare 5 and 2: swap to give [2, 5, 9, 1]</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Compare 5 and 9: no swap, [2, 5, 9, 1]</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Compare 9 and 1: swap to give [2, 5, 1, 9]</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">The largest value, 9, is now in its final position</div><span class=\"ms-codes\">(1)</span></div>",
