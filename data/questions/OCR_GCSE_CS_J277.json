      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Write an algorithm that asks the user to enter 10 numbers and then outputs the largest number and the mean of the numbers.</div><span class=\"q-marks\">(6)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<p>Example answer:</p>\n<pre class=\"q-code\"><code>total = 0\nlargest = 0\nfor count = 1 to 10\n    number = input(\"Enter a number\")\n    total = total + number\n    if count == 1 or number &gt; largest then\n        largest = number\n    endif\nnext count\nprint(largest)\nprint(total / 10)</code></pre>\n<div class=\"q-line\"><div class=\"q-line__text\">A loop that repeats 10 times</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Input taken inside the loop</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Running total kept</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Largest value compared and updated correctly</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Mean calculated as total ÷ 10</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">Both values output</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
