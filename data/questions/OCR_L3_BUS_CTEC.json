    "content": {
      "question_html": "<div class=\"q-line\"><div class=\"q-line__text\">Explain two differences between a private limited company and a public limited company.</div><span class=\"q-marks\">(4)</span></div>",
      "question_image_url": null,
      "mark_scheme_html": "<div class=\"q-line\"><div class=\"q-line__text\">Shares in a public limited company can be sold to the general public on a stock exchange</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">whereas shares in a private limited company are sold privately with the agreement of shareholders</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">A public limited company must have at least £50 000 of share capital and publish detailed accounts</div><span class=\"ms-codes\">(1)</span></div>\n<div class=\"q-line\"><div class=\"q-line__text\">whereas a private limited company has no minimum share capital and lighter reporting requirements</div><span class=\"ms-codes\">(1)</span></div>",
      "mark_scheme_image_url": null
    }
  },
