  "options_not_in_scope": {
    "Component 1 Shakespeare": "Antony and Cleopatra, Hamlet, King Lear (tragedy); A Midsummer Night’s Dream, Measure for Measure, The Taming of the Shrew, Twelfth Night (comedy)",
