// Cloudflare Workers config for purepastpapers.com.
// Every push to `main` on GitHub is built and deployed by Cloudflare (Workers Builds).
// The site is plain static files served straight from the repo root; nothing to build.
// Files listed in .assetsignore are kept out of the published site.
{
  "name": "purepastpapers",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
